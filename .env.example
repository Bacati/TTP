# Alertes pièces rares : copier en .env (jamais commité) ou déclarer dans l'hébergement

# Interrupteur général : tant que ce n'est pas "true", /alertes affiche « bientôt » et rien ne tourne
ALERTS_ENABLED=false

# Adresse publique du site, utilisée dans les liens des e-mails
SITE_URL=https://trouve-ta-piece.fr

# Deux secrets différents d'au moins 32 caractères : openssl rand -base64 48
ALERTS_SECRET=
ALERTS_RUN_TOKEN=

# Fichier SQLite : le dossier doit être un volume Docker persistant
ALERTS_DB_PATH=./data/alertes.sqlite

# Envoi des e-mails (SMTP de ton hébergeur mail ou d'un service type Brevo)
SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.fr:465
MAIL_FROM=Trouve ta pièce <alertes@trouve-ta-piece.fr>
# Adresse postale de l'expéditeur, affichée en bas de chaque e-mail (exigée par la loi et par l'eBay Partner Network)
MAIL_POSTAL_ADDRESS=Trouve ta pièce, 26 boulevard Robert Schuman, 44300 Nantes

# Derrière nginx ou un autre proxy : true pour lire l'IP réelle dans X-Forwarded-For
TRUST_PROXY=false

# eBay : n'activer qu'après l'accord écrit de l'eBay Partner Network pour la promotion par e-mail
EBAY_ENABLED=false
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=
EBAY_MARKETPLACE=EBAY_FR
EBAY_DAILY_BUDGET=4000
EBAY_CATEGORY_ID=

# Flux CSV de programmes d'affiliation qui autorisent l'e-mail (facultatif), en JSON sur une ligne
FEEDS=
