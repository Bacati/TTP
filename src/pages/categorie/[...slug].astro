---
export const prerender = true

import FilterBar from 'components/FilterBar.astro'
import PartnerCard from 'components/PartnerCard.astro'
import ProductCard from 'components/ProductCard.astro'
import ProductGrid from 'components/ProductGrid.astro'
import CategoryLayout from 'layouts/CategoryLayout.astro'
import {
	type CardModel,
	engineConfigToCard,
	getCategories,
	getCategory,
	getChildCategories,
	getEngineConfigs,
	getFacets,
	getPartnersForCategory,
	getProductsForCategory,
	partnerToCard,
	productToCard
} from 'libs/catalog'

export async function getStaticPaths() {
	const categories = await getCategories()
	return categories.map((c) => ({ params: { slug: c.id }, props: { id: c.id } }))
}

const { id } = Astro.props
const category = await getCategory(id)
if (!category) return Astro.redirect('/404')

const { name, intro, heroImage, heroImageAlt, heroPosition, layout, partnerStyle, filters, configRange } = category.data
const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '').trim()

let cards: Array<CardModel> = []
if (layout === 'configs' && configRange) {
	cards = (await getEngineConfigs(configRange)).map(engineConfigToCard)
} else if (layout === 'products') {
	cards = (await getProductsForCategory(id)).map(productToCard)
}
const facets = getFacets(cards)

const childCategories = layout === 'hub' ? await getChildCategories(id) : []
const partners = layout === 'hub' ? await getPartnersForCategory(id) : []

/** tuiles de la page hub, en `CardModel` (rendu carte produit) ou en props `PartnerCard` (tuile image) */
const hubCards: Array<CardModel> = [
	...childCategories.map((child) => ({
		title: child.data.name,
		image: child.data.tileImage ?? child.data.heroImage,
		imageAlt: child.data.tileImageAlt ?? child.data.heroImageAlt,
		typeLabel: stripHtml(child.data.intro),
		href: `/categorie/${child.id}`,
		external: false,
		engines: [] as Array<string>
	})),
	...partners.map(partnerToCard)
]

const site = Astro.site ?? Astro.url.origin
const parent = category.data.parent ? await getCategory(category.data.parent.id) : undefined
const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', site).href },
		...(parent ? [{ '@type': 'ListItem', position: 2, name: parent.data.name, item: new URL(`/categorie/${parent.id}`, site).href }] : []),
		{ '@type': 'ListItem', position: parent ? 3 : 2, name, item: new URL(`/categorie/${id}`, site).href }
	]
}
---

<CategoryLayout
	title={name}
	description={stripHtml(intro)}
	heroImage={heroImage}
	heroImageAlt={heroImageAlt}
	heroPosition={heroPosition}
	intro={intro}
	withBack={Boolean(category.data.parent)}
	jsonLd={breadcrumb}
>
	{layout === 'hub' ? (
		<div class="mx-auto flex w-11/12 flex-wrap justify-center gap-6 pb-10 lg:w-4/5">
			{partnerStyle === 'product'
				? hubCards.map((card) => <ProductCard {...card} />)
				: (
					<>
						{childCategories.map((child) => (
							<PartnerCard
								title={child.data.name}
								image={child.data.tileImage ?? child.data.heroImage}
								imageAlt={child.data.tileImageAlt ?? child.data.heroImageAlt}
								tagline={stripHtml(child.data.intro)}
								href={`/categorie/${child.id}`}
							/>
						))}
						{partners.map((partner) => (
							<PartnerCard
								title={partner.data.title}
								image={partner.data.image}
								imageAlt={partner.data.imageAlt}
								tagline={partner.data.tagline}
								logo={partner.data.logo}
								logoAlt={partner.data.logoAlt}
								href={partner.data.url}
							/>
						))}
					</>
				)}
		</div>
	) : (
		<>
			<FilterBar facets={facets} active={filters} />
			<ProductGrid cards={cards} />
		</>
	)}
</CategoryLayout>
