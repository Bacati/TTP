---
import NewsletterForm from 'components/NewsletterForm.astro'
import { BadgeEuro, Contact, Instagram } from 'lucide-astro'

const year = new Date().getFullYear()

export interface Props {
	links?: Array<{ href: string; target?: string; display: string }>
	socials?: Array<{ href: string; target?: string; icon: any }>
}
---

<footer class="w-full flex flex-col justify-center items-center py-16">
	<NewsletterForm />
	<div class="bg-white w-10/12 h-1 rounded-3xl"></div>
	<div class="w-11/12 flex justify-between gap-8 text-white items-center py-8 pr-0 flex-col lg:flex-row">
		<a href="/" class="w-52" ><img src="/images/logo2.svg" alt="TTP"></a>
		<p class="flex gap-3"><Contact />contact@trouve-ta-piece.fr</p>
		<a href="/categorie/astuce">Astuces mécaniques</a>
		<a href="/controle-technique">Contrôle technique 2-roues</a>
		<a href="/alertes">Alertes pièces rares</a>
		<a href="/mentions-legales">Mentions légales</a>
		<a href="https://paypal.me/trouvetapiece" target="_blank" rel="noopener noreferrer" title="paypal" class="flex gap-2"><BadgeEuro />Faire une donation</a>
		<div class="gap-3 flex">
			<a href="https://www.instagram.com/ttp_trouvetapiece.fr/" target="_blank" rel="noopener nofollow noreferrer"><Instagram /></a>
		</div>
	</div>
	<p class="font-light text-center text-white mt-4">© {year}&nbsp;TTP. Tout droits réservé.</p>
	<p class="font-light text-center text-white text-sm mt-2 px-4">En tant que Partenaire Amazon et partenaire eBay (eBay Partner Network), je réalise un bénéfice sur les achats remplissant les conditions requises.</p>
</footer>
