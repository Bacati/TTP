---
import { getCollection } from 'astro:content'
/**
 * Overlay de recherche global. Consomme directement le catalogue
 * (products + engineConfigs + partners) via `libs/catalog` — plus de liste
 * d'encarts recopiée à la main.
 */
import ProductCard from 'components/ProductCard.astro'
import { type CardModel, engineConfigToCard, productToCard } from 'libs/catalog'
import { Search, X } from 'lucide-astro'

type Row = { card: CardModel; haystack: string }

const [products, configs, partners, categories] = await Promise.all([getCollection('products'), getCollection('engineConfigs'), getCollection('partners'), getCollection('categories')])

// les éléments `hidden` (pas encore validés) ne doivent pas apparaître, ni les produits d'une catégorie masquée
const hiddenCats = new Set(categories.filter((c) => c.data.hidden).map((c) => c.id))

const catName = (id: string) => categories.find((c) => c.id === id)?.data.name ?? id

const rows: Array<Row> = [
	...configs.map((c) => ({
		card: engineConfigToCard(c),
		haystack: [c.data.name, c.data.brand, c.data.range, `${c.data.cc}cc`, ...c.data.engines].join(' ')
	})),
	...products.filter((p) => !hiddenCats.has(p.data.category.id)).map((p) => ({
		card: productToCard(p),
		haystack: [p.data.title, p.data.tagline, p.data.brandLogoAlt, catName(p.data.category.id), `${p.data.cc ?? ''}cc`, ...p.data.engines].join(' ')
	})),
	...partners.filter((p) => !p.data.hidden && !hiddenCats.has(p.data.category.id)).map((p) => ({
		card: {
			title: p.data.title,
			image: p.data.image,
			imageAlt: p.data.imageAlt,
			brandLogo: p.data.logo,
			brandLogoAlt: p.data.logoAlt,
			typeLabel: p.data.tagline,
			href: p.data.url ?? `/categorie/${p.data.category.id}`,
			external: Boolean(p.data.url && /^https?:\/\//.test(p.data.url)),
			engines: []
		} satisfies CardModel,
		haystack: [p.data.title, p.data.tagline, catName(p.data.category.id)].join(' ')
	}))
]

const norm = (s: string) =>
	s
		.toLowerCase()
		.normalize('NFD')
		.replace(/\p{Diacritic}/gu, '')
---

<div
	data-search-overlay
	hidden
	class="pointer-events-none fixed inset-0 z-[60] bg-black/60 opacity-0 backdrop-blur-sm transition-opacity duration-200"
>
	<div class="absolute inset-0 flex flex-col items-center sm:px-6 sm:pt-24 lg:px-10 lg:pt-28">
		<div
			data-search-container
			class="flex h-full w-full max-w-7xl flex-col overflow-hidden bg-[#0f1015] shadow-2xl sm:h-auto sm:max-h-[calc(100dvh-8rem)] sm:rounded-3xl sm:border sm:border-orange-400/40"
		>
			<div class="flex items-center gap-2 border-b border-white/10 px-3 py-3 sm:gap-3 sm:px-5 sm:py-4">
				<div class="flex min-w-0 flex-1 items-center gap-3 rounded-full bg-[#151624] px-4 py-2.5">
					<Search class="h-5 w-5 shrink-0 text-orange-400" aria-hidden="true" />
					<input
						data-search-input
						type="search"
						placeholder="Config, pièce, catégorie…" enterkeyhint="search" autocomplete="off"
						class="min-w-0 flex-1 bg-transparent text-base text-white outline-none placeholder:text-gray-400"
					/>
				</div>
				<button
					type="button"
					data-search-close
					aria-label="Fermer la recherche"
					class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/10 text-gray-300 hover:border-white/40 hover:text-white sm:w-auto sm:px-3 sm:text-sm"
				>
					<X class="h-5 w-5 sm:hidden" aria-hidden="true" />
					<span class="hidden sm:inline">Échap</span>
				</button>
			</div>

			<div class="px-4 py-2 text-xs text-gray-400 sm:px-5">
				<span data-search-count>{rows.length}</span> résultat(s)
			</div>

			<div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-3 pb-[max(1rem,env(safe-area-inset-bottom))] sm:px-5">
				<div data-search-results class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 py-3 md:gap-6 [&_.card]:mx-auto [&_.card]:w-full [&_.card]:max-w-96">
					{rows.map((row) => (
						<article class="product-card" data-search={norm(row.haystack)}>
							<ProductCard {...row.card} />
						</article>
					))}
				</div>
				<p data-search-empty hidden class="py-4 text-center text-sm text-gray-400">
					Aucun résultat. Essaie un autre mot (ex : Airsal, 70cc, casque, kit déco…).
				</p>
			</div>
		</div>
	</div>
</div>

<script>
	const overlay = document.querySelector<HTMLElement>('[data-search-overlay]')
	const container = overlay?.querySelector('[data-search-container]')
	const input = overlay?.querySelector<HTMLInputElement>('[data-search-input]')
	const cards = overlay ? Array.from(overlay.querySelectorAll<HTMLElement>('.product-card')) : []
	const countEl = overlay?.querySelector('[data-search-count]')
	const emptyEl = overlay?.querySelector<HTMLElement>('[data-search-empty]')

	const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '')

	// Le panneau reste `hidden` (images lazy, non chargées) tant
	// qu'il n'a jamais été ouvert — meilleur temps de chargement initial.
	function open() {
		if (!overlay) return
		document.body.style.overflow = 'hidden'
		overlay.hidden = false
		// charge toutes les images des résultats à la 1re ouverture (sinon les cartes non défilées restent vides)
		overlay.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => {
			img.loading = 'eager'
		})
		// force un reflow pour que la transition d'opacité s'anime bien
		// après la sortie de `display:none`.
		overlay.getBoundingClientRect()
		overlay.classList.remove('pointer-events-none')
		overlay.classList.add('opacity-100')
		if (input) {
			input.value = ''
			setTimeout(() => input.focus(), 10)
		}
		update()
	}
	function close() {
		if (!overlay) return
		document.body.style.overflow = ''
		overlay.classList.add('pointer-events-none')
		overlay.classList.remove('opacity-100')
		setTimeout(() => {
			if (overlay && !overlay.classList.contains('opacity-100')) overlay.hidden = true
		}, 200)
	}
	function update() {
		const q = norm(input?.value.trim() ?? '')
		let visible = 0
		for (const card of cards) {
			const show = !q || (card.dataset.search ?? '').includes(q)
			card.style.display = show ? '' : 'none'
			if (show) visible++
		}
		if (countEl) countEl.textContent = String(visible)
		if (emptyEl) emptyEl.hidden = visible !== 0
	}

	document.querySelectorAll('[data-open-search]').forEach((btn) =>
		btn.addEventListener('click', (e) => {
			e.preventDefault()
			open()
		}),
	)
	overlay?.querySelector('[data-search-close]')?.addEventListener('click', close)
	overlay?.addEventListener('click', (e) => {
		if (container && !container.contains(e.target as Node)) close()
	})
	window.addEventListener('keydown', (e) => e.key === 'Escape' && close())
	input?.addEventListener('input', update)
</script>
