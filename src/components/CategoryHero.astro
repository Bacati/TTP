---
import type { ImageMetadata } from 'astro'
/**
 * Entête de catégorie : image + texte, dans un cadre de dimensions CONSTANTES
 * sur toutes les pages (ratio fixe + `object-cover`). Remplace le bloc `<div
 * id="top">` recopié dans chaque ancienne page `categorie/*`.
 */
import Picture from 'components/global/Picture.astro'

interface Props {
	name: string
	image: ImageMetadata
	imageAlt: string
	/** cadrage vertical de l'image (défaut "center") */
	position?: 'center' | 'top' | 'bottom' | 'left' | 'right' | undefined
	/** texte d'intro (HTML autorisé) */
	intro: string
}

const { name, image, imageAlt, position = 'center', intro } = Astro.props

const positionClass = {
	center: 'object-center',
	top: 'object-top',
	bottom: 'object-bottom',
	left: 'object-left',
	right: 'object-right'
}[position]
---

<header class="mx-auto mt-20 flex w-11/12 flex-col items-center rounded-t-3xl bg-white lg:mt-0 lg:items-start">
	<div class="flex flex-col items-center gap-6 p-6 lg:flex-row lg:p-8">
		<div class="w-full max-w-xl shrink-0 overflow-hidden rounded-2xl sm:max-w-2xl lg:max-w-none lg:w-[28rem] xl:w-[34rem]">
			<Picture
				src={image}
				alt={imageAlt}
				width={800}
				height={360}
				loading="eager"
				class={`h-44 w-full object-cover sm:h-52 md:h-56 lg:h-60 ${positionClass}`}
			/>
		</div>
		<div>
			<h1 class="mb-2 text-2xl font-bold lg:text-3xl">{name}</h1>
			<div class="text-pretty leading-relaxed" set:html={intro} />
		</div>
	</div>
	<div class="h-2 w-full rounded-b-3xl gradient-config"></div>
</header>
