---
import type { ImageMetadata } from 'astro'
/**
 * Fiche détaillée d'une config moteur. Reprise fidèle de l'ancien
 * `components/global/TemplateConfig.astro` (carrousel `:target` + `<details>`
 * de détail des pièces) — seules les props changent (modèle `engineConfigs`).
 */
import Picture from 'components/global/Picture.astro'
import { ChevronDown, ChevronLeft, ChevronRight } from 'lucide-astro'
import motor from '../assets/images/motor.svg'

interface Props {
	name: string
	brand: string
	brandLogo: ImageMetadata
	rangeLabel: string
	engines: Array<string>
	description: string
	images: Array<ImageMetadata>
	pieces: Array<{ label: string; price: number }>
	total?: number | undefined
}

const { name, brand, brandLogo, rangeLabel, engines, description, images, pieces, total } = Astro.props
---

<div
	class="mx-4 mb-28 mt-96 flex flex-col items-center justify-center rounded-3xl bg-white py-6 md:mx-0 md:w-9/12 lg:mb-60 lg:mt-60 lg:h-[44rem] lg:flex-row"
>
	<div class="flex w-full items-center justify-between lg:w-6/12">
		<div class="relative h-40 w-full lg:h-96 lg:w-4/5">
			{images.map((_, index) => (
				<span id={`item-${index + 1}`}></span>
			))}

			{images.map((imageSrc, index) => (
				<div
					class={`carousel-item item-${index + 1} absolute bottom-0 left-0 right-0 top-0 mx-auto flex items-center justify-center opacity-0`}
				>
					<a href={`#item-${index === 0 ? images.length : index}`} class="z-30" aria-label="Image précédente">
						<ChevronLeft class="h-10 w-10 cursor-pointer" aria-hidden="true" />
					</a>
					<div class="flex w-8/12 items-center justify-center">
						<div class="fond-cyl flex h-40 w-40 items-center justify-center rounded-full cards md:w-2/4 lg:h-96 lg:w-96">
							<div class="lg:w-screen">
								<Picture
									src={imageSrc}
									alt={`${name} — vue ${index + 1}`}
									width={1000}
									height={500}
									loading={index === 0 ? 'eager' : 'lazy'}
									class="-ml-8 lg:-ml-16"
								/>
							</div>
						</div>
					</div>
					<a href={`#item-${index + 1 === images.length ? 1 : index + 2}`} class="z-30" aria-label="Image suivante">
						<ChevronRight class="h-10 w-10 cursor-pointer" aria-hidden="true" />
					</a>
				</div>
			))}
		</div>
	</div>

	<div class="w-full p-4 lg:ml-10 lg:w-1/3">
		<div class="mb-4 flex flex-col items-center justify-between sm:flex-row">
			<h1 class="text-4xl font-bold w-80">{name}</h1>
			<Picture src={brandLogo} alt={brand} class="w-20" />
		</div>

		<div class="mt-2 flex w-full items-center justify-between">
			<p class="w-28 text-gray-500 md:w-full">{rangeLabel}</p>
			{engines.length > 0 && (
				<div class="flex items-center gap-2">
					<Picture src={motor} alt="" class="h-12 w-12" />
					<div class="flex flex-col gap-2 md:mr-8 md:flex-row lg:mr-0">
						{engines.map((e) => (
							<p class="inline-flex items-center gap-1.5 rounded-full border border-orange-200 bg-orange-50 py-1 pl-2.5 pr-3 font-semibold text-neutral-900">
								<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-orange-500"></span>
								{e}
							</p>
						))}
					</div>
				</div>
			)}
		</div>

		<p class="mt-2 leading-relaxed text-gray-700">{description}</p>

		{total != null && (
			<div class="mt-4 flex items-center gap-4">
				<p class="text-gray-500">Coût total :</p>
				<p class="text-4xl font-bold">{total}€</p>
			</div>
		)}

		{pieces.length > 0 && (
			<details class="mt-4">
				<summary class="flex w-fit cursor-pointer list-none items-center gap-4 rounded-full bg-amber-600 p-2 px-8 text-xl text-white lg:hover:bg-slate-900">
					Voir le détail de la configuration
					<ChevronDown class="cheSum w-8 transition-transform duration-300 motion-reduce:transition-none" aria-hidden="true" />
				</summary>
				<ul class="mt-3 divide-y divide-slate-100 border-t border-slate-100">
					{pieces.map((piece) => (
						<li class="flex justify-between gap-4 py-1.5 text-sm">
							<span>{piece.label}</span>
							<span class="shrink-0 font-medium">{piece.price}€</span>
						</li>
					))}
				</ul>
			</details>
		)}
	</div>
</div>
