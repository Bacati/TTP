---
// Outfit est la police par défaut (cf. tailwind.config.cjs) : on la précharge.
// Oswald (chargée via assets/styles/fonts.scss) n'est actuellement utilisée
// par aucune classe du site ; pas de préchargement pour elle tant que c'est le cas.
import outfitFontUrl from 'assets/fonts/outfit-variable-latin.woff2?url'
import IconPNG from 'assets/layouts/Head/favicon.png'
import IconSVG from 'assets/layouts/Head/favicon.svg'
import Favicon from 'components/layouts/Favicon/Favicon.astro'

export interface Props {
	/** Nom d'affichage du site */
	siteName?: string | undefined
	/** Titre de la page */
	title?: string | undefined
	/** Description de la page (meta description + OG + Twitter) */
	description?: string | undefined
	/** URL canonique ; `false` pour la retirer */
	canonical?: string | false | undefined
	/** Directive robots (défaut : index,follow) */
	robots?: string | undefined
	/** Image OpenGraph */
	image?: typeof IconPNG | Array<typeof IconPNG> | undefined
	twitter?:
		| {
				title?: string | undefined
				card?: 'summary' | 'summary_large_image' | 'app' | 'player' | undefined
				site?: string | undefined
				creator?: string | undefined
		  }
		| undefined
	og?:
		| {
				title?: string | undefined
				type?: string | undefined
				description?: string | undefined
				url?: string | undefined
		  }
		| undefined
	/** Données structurées JSON-LD (objet ou tableau d'objets) */
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>> | undefined
}

const props = Astro.props

const DEFAULT_DESCRIPTION =
	'Trouve ta pièce (TTP) référence des pièces et configurations moto 50cc 2 temps, des plus classiques aux plus rares, avec des conseils de préparateur et une gamme de prix pour chaque budget.'

const description = props.description ?? DEFAULT_DESCRIPTION
const image = props.image ? (Array.isArray(props.image) ? props.image : [props.image]) : [IconPNG]

const canonical = typeof props.canonical === 'string' ? props.canonical : props.canonical === false ? undefined : new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href

const ogTitle = props.og?.title ?? props.title
const ogDescription = props.og?.description ?? description
const twitterTitle = props.twitter?.title ?? props.title
const jsonLdItems = props.jsonLd ? (Array.isArray(props.jsonLd) ? props.jsonLd : [props.jsonLd]) : []
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Police principale auto-hébergée : préchargée pour éviter le texte invisible (FOIT) -->
<link rel="preload" href={outfitFontUrl} as="font" type="font/woff2" crossorigin />

<!-- Analytics (proxy Plausible, même origine) -->
<script defer data-domain="trouve-ta-piece.fr" src="/js/script.js" is:inline></script>

<Favicon svg={IconSVG} png={IconPNG} icoPath="/favicon.ico" />

{props.title && <title>{props.title}</title>}
<meta name="description" content={description} />
<meta name="robots" content={props.robots ?? 'index,follow'} />
{canonical && <link rel="canonical" href={canonical} />}

{props.siteName && <meta property="og:site_name" content={props.siteName} />}
<meta property="og:type" content={props.og?.type ?? 'website'} />
{ogTitle && <meta property="og:title" content={ogTitle} />}
<meta property="og:description" content={ogDescription} />
{(props.og?.url ?? canonical) && <meta property="og:url" content={props.og?.url ?? canonical} />}
{image.map((img) => (
	<>
		<meta property="og:image" content={new URL(img.src, Astro.site ?? Astro.url.origin).href} />
		<meta property="og:image:type" content={`image/${img.format}`} />
		<meta property="og:image:width" content={img.width.toString()} />
		<meta property="og:image:height" content={img.height.toString()} />
	</>
))}

<meta name="twitter:card" content={props.twitter?.card ?? 'summary_large_image'} />
{props.twitter?.site && <meta name="twitter:site" content={props.twitter.site} />}
{props.twitter?.creator && <meta name="twitter:creator" content={props.twitter.creator} />}
{twitterTitle && <meta name="twitter:title" content={twitterTitle} />}
<meta name="twitter:description" content={ogDescription} />

{jsonLdItems.map((item) => (
	<script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />
))}

{/* Oswald + Outfit sont désormais auto-hébergées (voir assets/styles/fonts.scss) : plus de requête vers Google Fonts. */}
